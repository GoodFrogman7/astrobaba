# Private preview settings (docs/DEPLOY.md). Copy to deploy/.env with deploy/gen-secrets.sh,
# which fills every secret below. deploy/.env is git-ignored; never commit it.

# Base hostname. Without a domain, use the server's IP with dashes on sslip.io (free DNS):
# 203-0-113-7.sslip.io. The site is https://$DOMAIN, plus portal., admin., api. and lk.
DOMAIN=
# Let's Encrypt notices (expiry warnings) go here.
ACME_EMAIL=
# The server's public IPv4 (voice calls only).
PUBLIC_IP=

# Every page asks for this user and password (the hash is bcrypt, made by gen-secrets.sh).
PREVIEW_USER=preview
PREVIEW_PASSWORD_HASH=

# Secrets (gen-secrets.sh): Postgres password, HMAC key, chat message key, LiveKit keys.
POSTGRES_PASSWORD=
SECRET_KEY=
MESSAGES_KEY=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Optional features.
FLAG_VOICE_CALLS=false
FLAG_FIRST_FREE_SESSION=true
