# Copy to .env and fill in. .env is gitignored; never commit real values.
# Everything here is a local-dev default.

# development | test | staging | production
APP_ENV=development
LOG_LEVEL=INFO

# Postgres 16 (docker-compose service "postgres")
POSTGRES_USER=astro
POSTGRES_PASSWORD=astro-dev-only
POSTGRES_DB=astro
DATABASE_URL=postgresql+asyncpg://astro:astro-dev-only@localhost:5432/astro

# Redis (docker-compose service "redis")
REDIS_URL=redis://localhost:6379/0

# Service URLs
API_PORT=8000
ASTRO_PORT=8001
WEB_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
CORS_ORIGINS=["http://localhost:3000"]

# Feature flags: FLAG_<NAME>=true|false overrides packages/shared/flags/flags.json
# FLAG_RECHARGE_BONUS_TIERS=false

# Later phases (leave empty until needed)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
LLM_PROVIDER=gemini
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
