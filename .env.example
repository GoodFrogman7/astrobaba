# Copy to .env and fill in. .env is gitignored; never commit real values.
# Everything here is a local-dev default.

# development | test | staging | production
APP_ENV=development
LOG_LEVEL=INFO

# Postgres 16 (docker-compose service "postgres")
POSTGRES_USER=astro
POSTGRES_PASSWORD=astro-dev-only
POSTGRES_DB=astro
DATABASE_URL=postgresql+asyncpg://astro:astro-dev-only@localhost:5432/astro

# Redis (docker-compose service "redis")
REDIS_URL=redis://localhost:6379/0

# Service URLs
API_PORT=8000
ASTRO_PORT=8001
WEB_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Browser-facing WebSocket origin of the API (chat). Read at request time by web and astrologer.
API_WS_URL=ws://localhost:8000
CORS_ORIGINS=["http://localhost:3000", "http://localhost:3002"]

# Astro engine and API addresses as seen by the web server and worker
ASTRO_URL=http://localhost:8001
API_URL=http://localhost:8000

# API security. Staging/production refuse to start with the dev key, a key under 32 characters,
# or SMS_PROVIDER=console.
SECRET_KEY=dev-only-change-me
# console (dev/test only: prints OTPs to the API log) | msg91 (not implemented until an account exists)
SMS_PROVIDER=console
# KYC documents: local (dev/test only, files under DOCUMENTS_DIR) | s3 (required in staging/production)
DOCUMENTS_BACKEND=local
DOCUMENTS_DIR=
# Admins are users with the admin role: `uv run python -m astro_api.cli grant-role <phone> admin`
# Header holding the client IP behind a trusted proxy (for OTP rate limits), e.g. X-Forwarded-For
CLIENT_IP_HEADER=

# Feature flags: FLAG_<NAME>=true|false overrides packages/shared/flags/flags.json
# FLAG_RECHARGE_BONUS_TIERS=false

# Payments (Phase 4). "fake" simulates Razorpay in development; production requires razorpay
# with all three keys (Dashboard → Settings → API keys / Webhooks).
PAYMENTS_PROVIDER=fake
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Chat messages are encrypted at rest (AES-256-GCM). Base64 of 32 random bytes:
#   python -c "import base64,os;print(base64.b64encode(os.urandom(32)).decode())"
# Rotation: "k2:<new>,k1:<old>" (first encrypts, all decrypt). Required in production.
MESSAGES_KEY=

# Voice calls (Phase 5, flag voice_calls). The dev stack runs LiveKit on :7880 with dev keys.
# Production: LiveKit Cloud or a self-hosted server; secret >= 32 chars; browsers need wss://.
FLAG_VOICE_CALLS=
LIVEKIT_URL=http://localhost:7880
LIVEKIT_PUBLIC_URL=ws://localhost:7880
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Reports and partner leads (Phase 6). console = log only (development); production: smtp.
EMAIL_PROVIDER=console
EMAIL_FROM=AstroPlatform <no-reply@localhost>
SMTP_URL=
# Worker -> web print pages, and the Chromium used to print PDFs (empty = find it on PATH).
WEB_INTERNAL_URL=http://localhost:3000
CHROMIUM_PATH=

# Horoscope prose (worker). gemini | anthropic | fake (dev/test only). Use paid no-training tiers.
LLM_PROVIDER=gemini
LLM_TIMEOUT_S=90
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
ANTHROPIC_EFFORT=medium
