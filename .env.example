# Copy to .env and fill in. .env is gitignored; never commit real values.
# Everything here is a local-dev default.

# development | test | staging | production
APP_ENV=development
LOG_LEVEL=INFO

# Postgres 16 (docker-compose service "postgres")
POSTGRES_USER=astro
POSTGRES_PASSWORD=astro-dev-only
POSTGRES_DB=astro
DATABASE_URL=postgresql+asyncpg://astro:astro-dev-only@localhost:5432/astro

# Redis (docker-compose service "redis")
REDIS_URL=redis://localhost:6379/0

# Service URLs
API_PORT=8000
ASTRO_PORT=8001
WEB_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
CORS_ORIGINS=["http://localhost:3000"]

# Astro engine and API addresses as seen by the web server and worker
ASTRO_URL=http://localhost:8001
API_URL=http://localhost:8000

# API security. Staging/production refuse to start with the dev key, a key under 32 characters,
# or SMS_PROVIDER=console.
SECRET_KEY=dev-only-change-me
# console (dev/test only: prints OTPs to the API log) | msg91 (not implemented until an account exists)
SMS_PROVIDER=console
# Bearer token for /v1/admin/* (horoscope review). Admin API is disabled when empty.
ADMIN_TOKEN=
# Header holding the client IP behind a trusted proxy (for OTP rate limits), e.g. X-Forwarded-For
CLIENT_IP_HEADER=

# Feature flags: FLAG_<NAME>=true|false overrides packages/shared/flags/flags.json
# FLAG_RECHARGE_BONUS_TIERS=false

# Later phases (leave empty until needed)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Horoscope prose (worker). gemini | anthropic | fake (dev/test only). Use paid no-training tiers.
LLM_PROVIDER=gemini
LLM_TIMEOUT_S=60
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
ANTHROPIC_EFFORT=medium
